# Render environment values, not a file to commit with real credentials.
APP_NAME=BranchFlow
APP_ENV=production
APP_DEBUG=false
# Generate once using: php artisan key:generate --show
APP_KEY=
# APP_URL can be omitted on Render: RENDER_EXTERNAL_URL is used automatically.
FORCE_HTTPS=true
TRUST_PROXIES=true
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/branchflow.sqlite
DEPLOY_EPHEMERAL_SQLITE=true
DB_TIMEZONE=Africa/Lagos
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
LOG_CHANNEL=stderr
LOG_LEVEL=warning
OWNER_NAME="Business Owner"
OWNER_EMAIL=
OWNER_PASSWORD=
# Recreated after the temporary database disappears.
DEPLOY_SEED_DEMO=true
DEPLOY_DEMO_STAFF_PASSWORD=
PGCONNECT_TIMEOUT=10
